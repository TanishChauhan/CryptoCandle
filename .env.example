# Copy to .env: cp .env.example .env

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_TRADES=crypto_trades
KAFKA_TOPIC_DLQ=dead_letter_queue

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto_secret
POSTGRES_DB=crypto_analytics
POSTGRES_AIRFLOW_DB=airflow

BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_REST_BASE=https://api.binance.com
SYMBOLS=BTCUSDT,ETHUSDT

SPARK_CHECKPOINT_DIR=/data/checkpoints/stream_trades
RAW_DATA_DIR=/data/raw/trades
RAW_DATA_COMPACTED_DIR=/data/raw/trades_compacted
BATCH_COALESCE_PARTITIONS=1
BACKFILL_LOOKBACK_HOURS=2
BACKFILL_MAX_TIME_SKEW_MS=604800000

# Spark streaming: window lateness before 1m candles close (not DLQ threshold)
WATERMARK_MINUTES=2 minutes
# Trades older than this at processing time route to DLQ (decoupled from watermark)
LATE_EVENT_AFTER_MINUTES=30
# Kafka offset on fresh start: latest | earliest
STARTING_OFFSETS=latest
MAX_TIME_SKEW_MS=86400000
STREAM_TRIGGER_SECONDS=95
SPARK_LOG_LEVEL=WARN

HOST_DATA_DIR=./data

# Same value on webserver + scheduler (fixes UI log viewer 403)
AIRFLOW_SECRET_KEY=local_dev_airflow_secret_key

LOG_LEVEL=INFO
LOG_JSON=true

DLQ_WARN_RATIO=0.01
DLQ_FAIL_RATIO=0.05

# Streamlit dashboard auto-refresh interval (seconds, minimum 10)
DASHBOARD_REFRESH_SECONDS=30

# Dashboard chart: only show 1m candles from the last N hours
CANDLES_LOOKBACK_HOURS=24

# Pipeline Health tab: metrics query + chart window (hours)
PIPELINE_METRICS_LOOKBACK_HOURS=24

# Automated retention (data-retention container + crypto_data_retention Airflow DAG)
RETENTION_KEEP_DAYS=1
RETENTION_SUMMARIZE_FIRST=true
RETENTION_INTERVAL_HOURS=24
RETENTION_METRICS_KEEP_DAYS=7
